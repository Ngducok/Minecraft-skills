{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngducok.github.io/Minecraft-skills/schemas/skill.schema.json",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "category": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z]+(?:/[a-z]+)*$"
    },
    "supports": {
      "type": "object",
      "properties": {
        "editions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "java",
              "bedrock"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "vanilla",
              "paper",
              "purpur",
              "spigot",
              "folia",
              "velocity",
              "fabric",
              "forge",
              "neoforge",
              "bedrock",
              "hybrid"
            ]
          },
          "uniqueItems": true
        },
        "verified_versions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "policy": {
          "type": "string",
          "enum": [
            "resolve-exact-target"
          ]
        }
      },
      "required": [
        "editions",
        "platforms",
        "verified_versions",
        "policy"
      ],
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "properties": {
        "context": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "edition",
              "minecraft",
              "platform"
            ]
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "java": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "context",
        "java"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "name",
    "version",
    "description",
    "category",
    "supports",
    "requires",
    "inputs",
    "outputs",
    "validation",
    "sources"
  ],
  "additionalProperties": false
}
